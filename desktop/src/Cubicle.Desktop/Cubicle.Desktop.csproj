<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (system tray) lives in Windows Forms. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Cubicle</AssemblyName>
    <RootNamespace>Cubicle.Desktop</RootNamespace>
    <ApplicationIcon>Assets\cubicle.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.0</Version>
    <Product>Cubicle</Product>
    <Company>Cubicle contributors</Company>
    <Description>Your personal AI staff.</Description>
    <!-- WPF Fluent theme (ThemeMode) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WPF/WinForms name clashes (Application, MessageBox, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cubicle.Client\Cubicle.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\cubicle.ico" />
    <Resource Include="Assets\cubicle-256.png" />
  </ItemGroup>

</Project>
