<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Keys must match Palette.Light.xaml; ThemeService swaps the two at runtime. -->
    <Color x:Key="AppBackgroundColor">#111318</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111318" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#16181F" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1F27" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#222630" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#262A35" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2C303C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#252934" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEEF3" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A9B7" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6F7584" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#17192B" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FFB020" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFC04D" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFC04D" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EFFB020" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#2BC48A" />
    <SolidColorBrush x:Key="InfoBrush" Color="#5B9BFF" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB020" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#7B8191" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#33FF6B6B" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#0D0F13" />
</ResourceDictionary>
