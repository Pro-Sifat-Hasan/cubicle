<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Keys must match Palette.Dark.xaml; ThemeService swaps the two at runtime. -->
    <Color x:Key="AppBackgroundColor">#F5F6F8</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F2F3F6" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EEF0F4" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E5EB" />
    <SolidColorBrush x:Key="DividerBrush" Color="#ECEEF2" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17192B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C6374" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9298A6" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#17192B" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FFB020" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F5A300" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A86A00" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#24FFB020" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#1FA672" />
    <SolidColorBrush x:Key="InfoBrush" Color="#3A78E8" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E09400" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#8A90A0" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FE5484D" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#F2F3F6" />
</ResourceDictionary>
