<Window x:Class="Cubicle.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Cubicle.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Cubicle — your personal AI staff"
        Icon="/Assets/cubicle.ico"
        Width="1200" Height="780" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Navigation rail ============ -->
        <Border Grid.Column="0" Padding="14,18" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,22">
                    <Image Source="/Assets/cubicle.ico" Width="34" Height="34" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Cubicle" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="your personal AI staff" FontSize="11" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource SlateBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource MintBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionText}" FontSize="12" TextWrapping="Wrap" MaxWidth="180" />
                    </StackPanel>
                    <TextBlock Text="{Binding UsageText}" FontSize="11" Margin="17,4,0,0" Style="{StaticResource Muted}" />
                </StackPanel>

                <ListBox SelectedIndex="{Binding SelectedSection}" BorderThickness="0" Background="Transparent">
                    <ListBoxItem Padding="10,9">
                        <TextBlock Text="☀  Today" FontSize="14" />
                    </ListBoxItem>
                    <ListBoxItem Padding="10,9">
                        <DockPanel LastChildFill="False" Width="170">
                            <TextBlock Text="✉  Inbox" FontSize="14" />
                            <Border DockPanel.Dock="Right" Background="{StaticResource AmberBrush}" CornerRadius="9" Padding="7,0"
                                    Visibility="{Binding OpenQuestions, Converter={StaticResource CountToVisibility}}">
                                <TextBlock Text="{Binding OpenQuestions}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="12" />
                            </Border>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="10,9">
                        <TextBlock Text="⟳  Routines" FontSize="14" />
                    </ListBoxItem>
                    <ListBoxItem Padding="10,9">
                        <TextBlock Text="☰  Activity" FontSize="14" />
                    </ListBoxItem>
                    <ListBoxItem Padding="10,9">
                        <TextBlock Text="⚙  Settings" FontSize="14" />
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <DockPanel Grid.Column="1">

            <!-- Banners -->
            <StackPanel DockPanel.Dock="Top">
                <Border Background="{StaticResource CoralBrush}" Padding="16,8"
                        Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissErrorCommand}" />
                        <TextBlock Text="{Binding ErrorText}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                <Border Background="{StaticResource AmberSoftBrush}" Padding="16,10"
                        Visibility="{Binding BreakerOpen, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Resume work" Command="{Binding ResetBreakerCommand}" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="⏸  Work is paused: today's token budget is used up. Resume to let your staff continue." />
                    </DockPanel>
                </Border>
                <Border Background="{StaticResource AmberSoftBrush}" Padding="16,10"
                        Visibility="{Binding NeedsApiKey, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Add API key" Command="{Binding NavigateCommand}" CommandParameter="4" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="🧪  Demo mode: your staff are using sample answers. Add an Anthropic API key to put them to real work." />
                    </DockPanel>
                </Border>
            </StackPanel>

            <TabControl SelectedIndex="{Binding SelectedSection}" BorderThickness="0" Padding="0" Background="Transparent">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- ===== Today ===== -->
                <TabItem>
                    <Grid Margin="28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="What should your staff do?" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Describe the outcome you want. Your Chief of Staff plans it, hands pieces to the right people, and brings you the finished result." />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="15"
                                             ToolTip="e.g. Draft replies to this week's client emails" />
                                    <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160"
                                             VerticalScrollBarVisibility="Auto"
                                             ToolTip="Details, context, links, tone… (optional)" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Assign  →" Style="{StaticResource AccentButton}" Margin="12,0,0,0"
                                        VerticalAlignment="Top" Command="{Binding AssignCommand}" IsDefault="True" />
                            </Grid>
                        </Border>

                        <!-- Staff -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,14">
                            <TextBlock Text="Your staff" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Staff}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Width="200" Margin="0,0,10,10" Padding="12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Avatar}" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Title}" FontSize="12" Style="{StaticResource Muted}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                                 Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabel}}" FontSize="12" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Assignments + detail -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Assignments" Style="{StaticResource SectionTitle}" />
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8"
                                           Visibility="{Binding Assignments.Count, Converter={StaticResource ZeroToVisibility}}"
                                           Text="Nothing yet. Give your staff their first assignment above." />
                                <ListBox ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,4">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Style="{StaticResource StatusPill}" Tag="{Binding Status}">
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="White" />
                                                    </Border>
                                                    <TextBlock Text="{Binding When}" FontSize="11" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" Style="{StaticResource Muted}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="Select an assignment to see the plan and the result."
                                               Visibility="{Binding SelectedDetail, Converter={StaticResource NotNullToCollapsed}}" />
                                    <DockPanel Visibility="{Binding SelectedDetail, Converter={StaticResource NullToVisibility}}">
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelSelectedCommand}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedDetail.Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <Border Style="{StaticResource StatusPill}" Tag="{Binding SelectedDetail.Status}" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding SelectedDetail.Status, Converter={StaticResource StatusToLabel}}"
                                                               FontSize="11" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedDetail.Error}" Foreground="{StaticResource CoralBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Visibility="{Binding SelectedDetail.Error, Converter={StaticResource NullToVisibility}}" />

                                        <Expander DockPanel.Dock="Top" Header="Plan and progress" IsExpanded="True" Margin="0,0,0,10"
                                                  Visibility="{Binding SelectedSubtasks.Count, Converter={StaticResource CountToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding SelectedSubtasks}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,3">
                                                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0"
                                                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" FontSize="12" Style="{StaticResource Muted}" />
                                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Assignee, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text=" — " />
                                                                <Run Text="{Binding Title, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>

                                        <TextBox Text="{Binding SelectedDetail.Result, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" BorderThickness="0"
                                                 Background="Transparent" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== Inbox ===== -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24" MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="Inbox" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Only things that genuinely need you end up here. Answer and the work continues automatically." />
                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding Inbox.Count, Converter={StaticResource ZeroToVisibility}}">
                                <TextBlock Text="🎉  Inbox zero. Your staff have everything they need." />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Inbox}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                                    <Run Text="{Binding EmployeeName, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" asked · " />
                                                    <Run Text="{Binding Asked, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Item.Question}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,10" />
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Send" Style="{StaticResource AccentButton}" Margin="10,0,0,0"
                                                            Command="{Binding SendCommand}" VerticalAlignment="Top" />
                                                    <TextBox Text="{Binding AnswerText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                             TextWrapping="Wrap" MinHeight="40" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Routines ===== -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24" MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="Routines" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="Standing orders your staff carry out on a schedule — set them once and they get done every day, even when this window is closed." />

                            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="New routine" Style="{StaticResource SectionTitle}" />
                                    <TextBox Text="{Binding RoutineTitle, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="e.g. Morning briefing: plan my day from my notes" />
                                    <TextBox Text="{Binding RoutineDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                             ToolTip="Exactly what should be done each time, and what a great result looks like." />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <ComboBox ItemsSource="{Binding RoutineKinds}" SelectedIndex="{Binding RoutineKind}" Width="170" />
                                        <TextBlock Text="at" VerticalAlignment="Center" Margin="10,0" />
                                        <TextBox Text="{Binding RoutineTime, UpdateSourceTrigger=PropertyChanged}" Width="80" ToolTip="24h time, e.g. 09:00" />
                                        <TextBlock Text="or every" VerticalAlignment="Center" Margin="10,0" />
                                        <TextBox Text="{Binding RoutineEveryMinutes, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <TextBlock Text="min" VerticalAlignment="Center" Margin="6,0,16,0" />
                                        <Button Content="Add routine" Style="{StaticResource AccentButton}" Command="{Binding CreateRoutineCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Routines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding Enabled}" Content="On" Margin="0,0,12,0" />
                                                    <Button Content="Delete" Command="{Binding DeleteCommand}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Routine.Title}" FontWeight="SemiBold" FontSize="15" />
                                                    <TextBlock Text="{Binding When}" Margin="0,2,0,0" />
                                                    <TextBlock FontSize="12" Style="{StaticResource Muted}" Margin="0,2,0,0">
                                                        <Run Text="{Binding NextRun, Mode=OneWay}" />
                                                        <Run Text="  ·  " />
                                                        <Run Text="{Binding LastRun, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Activity ===== -->
                <TabItem>
                    <DockPanel Margin="28,24">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Activity" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="Everything your office did, newest first." />
                        </StackPanel>
                        <ListView ItemsSource="{Binding Activity}" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Width="120" FontSize="12" Style="{StaticResource Muted}"
                                                   Text="{Binding CreatedAt, StringFormat='{}{0:ddd HH:mm:ss}'}" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </TabItem>

                <!-- ===== Settings ===== -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource PageSubtitle}" Text="Everything stays on this PC. Keys are encrypted with Windows DPAPI and never shown again." />

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Anthropic API key" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                                               Text="Your staff use Claude. Create a key at console.anthropic.com and paste it here. Saving restarts your staff with the new key." />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Save key" Style="{StaticResource AccentButton}" Margin="10,0,0,0"
                                                Click="SaveApiKey_Click" />
                                        <PasswordBox x:Name="ApiKeyBox" />
                                    </DockPanel>
                                    <TextBlock Margin="0,10,0,0" FontSize="12" Style="{StaticResource Muted}">
                                        <Run Text="Configured secrets: " />
                                        <Run Text="{Binding ConfiguredSecrets.Count, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Background" Style="{StaticResource SectionTitle}" />
                                    <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start Cubicle when I sign in to Windows (runs quietly in the tray)" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                               Text="Closing this window keeps your staff working. Use the tray icon → 'Stop staff and quit' to stop everything." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Data" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,10,0" />
                                        <Button Content="Resume paused work" Command="{Binding ResetBreakerCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                                               Text="Cubicle is free and open source (MIT). Star it, report bugs, or hire new kinds of employees on GitHub." />
                                    <Button Content="Open GitHub repository" Command="{Binding OpenRepoCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
