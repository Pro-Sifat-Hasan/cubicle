<Window x:Class="Cubicle.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Cubicle.Desktop.ViewModels"
        xmlns:pages="clr-namespace:Cubicle.Desktop.Views.Pages"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Cubicle"
        Icon="/Assets/cubicle.ico"
        Width="1280" Height="820" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        SizeChanged="Window_SizeChanged">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Navigation rail ================= -->
        <Border Background="{DynamicResource RailBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="244" />
                    <Setter Property="Padding" Value="14,18" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact}" Value="True">
                            <Setter Property="Width" Value="72" />
                            <Setter Property="Padding" Value="10,18" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Image Source="/Assets/cubicle-256.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Cubicle" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="Your personal AI staff" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <!-- Footer: status + theme -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,10"
                            Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource NeutralBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionText}" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding UsageText}" Style="{StaticResource Caption}" Margin="16,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Compact rail: one button that cycles the theme -->
                    <Button Style="{StaticResource GhostButton}" Command="{Binding CycleThemeCommand}" ToolTip="{Binding ThemeTooltip}" Padding="0,9"
                            Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding ThemeGlyph}" FontSize="15" />
                    </Button>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="3"
                            Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}">
                        <UniformGrid Columns="3">
                            <RadioButton Style="{StaticResource SegmentButton}" ToolTip="Light theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentButton}" ToolTip="Dark theme"
                                         IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentButton}" ToolTip="Match Windows"
                                         IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <!-- Navigation -->
                <ListBox SelectedIndex="{Binding SelectedSection}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.Resources>
                        <Style TargetType="TextBlock" x:Key="NavLabel" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Margin" Value="14,0,0,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <Setter Property="Visibility" Value="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Style>
                        <Style TargetType="TextBlock" x:Key="NavIcon" BasedOn="{StaticResource Icon}">
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem ToolTip="Today">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Today" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Inbox">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE715;" />
                                <TextBlock Style="{StaticResource NavLabel}" Text="Inbox" />
                            </StackPanel>
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="999" Padding="7,0" MinWidth="20" Height="20"
                                    HorizontalAlignment="Right" Margin="0,0,-4,0"
                                    Visibility="{Binding DataContext.OpenQuestions, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource CountToVisibility}}">
                                <TextBlock Text="{Binding DataContext.OpenQuestions, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           Foreground="{DynamicResource TextOnAccentBrush}" FontWeight="Bold" FontSize="11.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Agents">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE716;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Agents" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Automations">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8EE;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Automations" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Tools &amp; skills">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE90F;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Tools &amp; skills" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Memory">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xEA80;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Memory" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Activity">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE81C;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Activity" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem ToolTip="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="Settings" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top">
                <Border Background="{DynamicResource DangerSoftBrush}" Padding="20,10"
                        Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Dismiss" Command="{Binding DismissErrorCommand}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding ErrorText}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" />
                    </DockPanel>
                </Border>
                <Border Background="{DynamicResource AccentSoftBrush}" Padding="20,10"
                        Visibility="{Binding BreakerOpen, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Resume work" Command="{Binding ResetBreakerCommand}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" Margin="0,0,10,0" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Work is paused: today's token budget is used up." />
                    </DockPanel>
                </Border>
                <Border Background="{DynamicResource AccentSoftBrush}" Padding="20,10"
                        Visibility="{Binding Ai.IsDemo, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Connect an AI" Command="{Binding NavigateCommand}" CommandParameter="7" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Margin="0,0,10,0" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Demo mode: your staff give sample answers until you connect an AI." />
                    </DockPanel>
                </Border>
            </StackPanel>

            <TabControl SelectedIndex="{Binding SelectedSection}" BorderThickness="0" Padding="0" Background="Transparent">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabItem><pages:TodayPage /></TabItem>
                <TabItem><pages:InboxPage /></TabItem>
                <TabItem><pages:AgentsPage /></TabItem>
                <TabItem><pages:AutomationsPage /></TabItem>
                <TabItem><pages:ToolsPage /></TabItem>
                <TabItem><pages:MemoryPage /></TabItem>
                <TabItem><pages:ActivityPage /></TabItem>
                <TabItem><pages:SettingsPage /></TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
