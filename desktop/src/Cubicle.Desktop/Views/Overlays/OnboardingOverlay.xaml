<UserControl x:Class="Cubicle.Desktop.Views.Overlays.OnboardingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cubicle.Desktop.ViewModels"
             xmlns:controls="clr-namespace:Cubicle.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}">
    <!-- Covers the whole window until setup is done, so nothing behind it is clickable. -->
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="780" Margin="32,40" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <TextBlock Text="{Binding StepText}" Style="{StaticResource Caption}" Margin="0,0,0,8" />

                <!-- ============ 1. Name ============ -->
                <StackPanel Visibility="{Binding IsNameStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="What do you want to call your chief of staff?" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,22"
                               Text="They plan your work, lead your team and ask you only when it matters. Pick a name or type your own." />
                    <TextBox Text="{Binding AgentName, UpdateSourceTrigger=PropertyChanged}" FontSize="18" MaxLength="60"
                             controls:Placeholder.Text="A name, like Nova" />
                    <ItemsControl ItemsSource="{Binding NameSuggestions}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                        Command="{Binding DataContext.PickNameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="AND WHAT SHOULD THEY CALL YOU?" Style="{StaticResource Label}" Margin="0,22,0,6" />
                    <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                             controls:Placeholder.Text="Your first name (optional)" />
                </StackPanel>

                <!-- ============ 2. Profession ============ -->
                <StackPanel Visibility="{Binding IsProfessionStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="What do you do?" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,18"
                               Text="Your profession decides the team that gets hired, the routines they run and the missions we suggest." />
                    <ListBox ItemsSource="{Binding Professions}" SelectedItem="{Binding SelectedProfession}"
                             Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CardItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="210" Margin="0,0,10,0">
                                    <TextBlock FontSize="24" Text="{Binding Emoji}" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="WHAT DO YOU WORK WITH? (OPTIONAL)" Style="{StaticResource Label}" Margin="0,14,0,6" />
                    <TextBox Text="{Binding StackText, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"
                             controls:Placeholder.Text="Tools, languages or platforms, separated by commas: Python, AWS, Premiere Pro…" />
                </StackPanel>

                <!-- ============ 3. Passion ============ -->
                <StackPanel Visibility="{Binding IsPassionStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="What are you into?" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,18"
                               Text="Your passion gives your chief of staff their voice, and their daily interest feed. Or type your own and they write it themselves." />
                    <ListBox ItemsSource="{Binding Passions}" SelectedItem="{Binding SelectedPassion}"
                             Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CardItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Width="170">
                                    <TextBlock FontSize="22" Text="{Binding Emoji}" VerticalAlignment="Center" />
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Border Height="3" Width="28" CornerRadius="2" HorizontalAlignment="Left" Margin="0,5,0,0"
                                                Background="{Binding AccentColor}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding IsCustomPassion, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="YOUR PASSION" Style="{StaticResource Label}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding CustomPassionText, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
                                 controls:Placeholder.Text="Anything: urban gardening, retro synths, Formula 1…" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- ============ 4. Hiring ============ -->
                <StackPanel Visibility="{Binding IsHiringStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Building your staff" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,18" Text="This takes a few seconds." />
                    <ItemsControl ItemsSource="{Binding HireLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Grid Width="22" Height="22" Margin="0,0,12,0">
                                        <ProgressBar IsIndeterminate="True" Width="18" Height="3" VerticalAlignment="Center"
                                                     Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{DynamicResource SuccessBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Text}" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource AccentButton}" Content="Meet your team"
                            Command="{Binding ContinueCommand}" Visibility="{Binding HiringDone, Converter={StaticResource BoolToVisibility}}" />
                    <Button Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Content="Go back and try again"
                            Command="{Binding RetryHiringCommand}" Visibility="{Binding HiringFailed, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- ============ 5. First mission ============ -->
                <StackPanel Visibility="{Binding IsMissionStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Give your team a first mission" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,18"
                               Text="One tap and they get to work. You will see the plan and the result in Today." />
                    <ItemsControl ItemsSource="{Binding Missions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="16,12" Style="{StaticResource GhostButton}"
                                        Command="{Binding DataContext.ChooseMissionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding}" FontSize="14.5" TextWrapping="Wrap" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Skip and look around" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Command="{Binding FinishCommand}" />
                </StackPanel>

                <!-- Navigation -->
                <DockPanel Margin="0,26,0,0" LastChildFill="False" Visibility="{Binding ShowNext, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{Binding NextText}" Command="{Binding NextCommand}" IsDefault="True" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Back" Command="{Binding BackCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
