<UserControl x:Class="Cubicle.Desktop.Views.Pages.TodayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cubicle.Desktop.ViewModels"
             xmlns:controls="clr-namespace:Cubicle.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Grid Margin="32,28,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ============ Left: command bar, needs you, assignments, team ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
            <StackPanel MaxWidth="940" HorizontalAlignment="Stretch">

                <!-- Greeting -->
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}" FontSize="26" TextWrapping="Wrap" TextTrimming="None" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,18" />

                <!-- Command bar -->
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,22">
                    <StackPanel>
                        <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="12,10"
                                 controls:Placeholder.Text="What should your staff do?" />
                        <Expander Style="{StaticResource LinkExpander}" Margin="0,6,0,0">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextBrush}" />
                                    <TextBlock Text="Add details" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                            </Expander.Header>
                            <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="80" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                     controls:Placeholder.Text="Context, links, tone, deadline… (optional)" />
                        </Expander>
                        <DockPanel Margin="0,8,0,0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Give it to" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding AssignTargets}" SelectedItem="{Binding AssignTo}" DisplayMemberPath="Label"
                                      MinWidth="220" MaxWidth="340" ToolTip="Who gets this assignment" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding AssignCommand}" IsDefault="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Assign" Foreground="{DynamicResource TextOnAccentBrush}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="13" Margin="8,0,0,0" Foreground="{DynamicResource TextOnAccentBrush}" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Reports: the main agent writes them from what the staff really did -->
                <DockPanel Margin="0,-8,0,22" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="REPORTS" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Command="{Binding WriteReportCommand}" CommandParameter="today"
                            Padding="12,7" Margin="0,0,8,0" ToolTip="Everything the staff did today: finished work, what is open, what needs you">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextBrush}" />
                            <TextBlock Text="Today" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Command="{Binding WriteReportCommand}" CommandParameter="yesterday"
                            Padding="12,7" Margin="0,0,8,0" ToolTip="What the staff did yesterday">
                        <TextBlock Text="Yesterday" FontWeight="SemiBold" FontSize="13" />
                    </Button>
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Command="{Binding WriteReportCommand}" CommandParameter="week"
                            Padding="12,7" Margin="0,0,8,0" ToolTip="This week so far, Monday to now">
                        <TextBlock Text="This week" FontWeight="SemiBold" FontSize="13" />
                    </Button>
                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Command="{Binding WriteReportCommand}" CommandParameter="last_week"
                            Padding="12,7" ToolTip="The whole of last week">
                        <TextBlock Text="Last week" FontWeight="SemiBold" FontSize="13" />
                    </Button>
                </DockPanel>

                <!-- Needs you -->
                <StackPanel Visibility="{Binding Inbox.Count, Converter={StaticResource CountToVisibility}}" Margin="0,0,0,22">
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Left" Background="{DynamicResource WarningBrush}" CornerRadius="999" Padding="8,1" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Inbox.Count}" Foreground="#17192B" FontWeight="Bold" FontSize="12" />
                        </Border>
                        <TextBlock Text="Needs you" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Inbox}" ItemTemplate="{StaticResource RequestCardTemplate}" />
                </StackPanel>

                <!-- Assignments: newest first -->
                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Text="{Binding DoneCount, StringFormat={}{0} done}" />
                    <TextBlock Text="Assignments" Style="{StaticResource SectionTitle}" Margin="0" />
                </DockPanel>
                <Border Style="{StaticResource EmptyState}" Visibility="{Binding Assignments.Count, Converter={StaticResource ZeroToVisibility}}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="Nothing yet. Describe an outcome above, or start with one of these." />
                        <ItemsControl ItemsSource="{Binding StarterMissions}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                            Command="{Binding DataContext.StartMissionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}"
                         Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource CardItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="List_PreviewMouseWheel" Margin="0,0,0,14">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}" Tag="{Binding Status}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource PillText}" />
                                    </Border>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" />
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Team -->
                <DockPanel Margin="0,8,0,10">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Text="{Binding Staff.Count, StringFormat={}{0} people}" />
                    <TextBlock Text="Your team" Style="{StaticResource SectionTitle}" Margin="0" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Staff}" Margin="0,0,0,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="12,10" Margin="0,0,10,10" Width="214" ToolTip="{Binding Description}">
                                <DockPanel>
                                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource AvatarSquareTemplate}"
                                                      Width="38" Height="38" VerticalAlignment="Top" Margin="0,0,11,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" FontSize="11.5" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Ellipse Width="7" Height="7" Margin="0,1,6,0" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabel}}" Style="{StaticResource Caption}" FontSize="11.5" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Right: the selected assignment (closes with X, opens by clicking an assignment) ============ -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Width="480" Margin="24,0,0,0"
                Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Margin="24,20,16,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding CloseDetailCommand}" VerticalAlignment="Top"
                            ToolTip="Close" Padding="9,7">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="13" />
                    </Button>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding SelectedDetail.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextTrimming="None" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Border Style="{StaticResource StatusPill}" Tag="{Binding SelectedDetail.Status}">
                                <TextBlock Text="{Binding SelectedDetail.Status, Converter={StaticResource StatusToLabel}}" Style="{StaticResource PillText}" />
                            </Border>
                            <TextBlock Text="{Binding DetailMeta}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,0,24,24">
                        <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,14"
                                Visibility="{Binding SelectedDetail.Error, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding SelectedDetail.Error}" TextWrapping="Wrap" TextTrimming="None" />
                        </Border>

                        <!-- Result -->
                        <TextBlock Text="RESULT" Style="{StaticResource Label}" />
                        <Grid Margin="0,0,0,18">
                            <TextBlock Style="{StaticResource Muted}" Text="Your team is working on it. The finished work will appear here."
                                       Visibility="{Binding SelectedDetail.Result, Converter={StaticResource NotNullToCollapsed}}" />
                            <FlowDocumentScrollViewer controls:Markdown.Source="{Binding SelectedDetail.Result}" controls:WheelPassthrough.IsEnabled="True"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Visibility="{Binding SelectedDetail.Result, Converter={StaticResource NullToVisibility}}" />
                        </Grid>

                        <!-- Plan and team (collapsed) -->
                        <Expander Style="{StaticResource SectionExpander}" IsExpanded="{Binding PlanExpanded, Mode=TwoWay}" Margin="0,0,0,10"
                                  Visibility="{Binding SelectedSubtasks.Count, Converter={StaticResource CountToVisibility}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE762;" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextBrush}" />
                                    <TextBlock Text="Plan and team" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding SelectedSubtasks}" ItemTemplate="{StaticResource PlanStepTemplate}" />
                        </Expander>

                        <!-- Thinking and tools (collapsed) -->
                        <Expander Style="{StaticResource SectionExpander}" IsExpanded="{Binding ActivityExpanded, Mode=TwoWay}"
                                  Visibility="{Binding SelectedActivity.Count, Converter={StaticResource CountToVisibility}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextBrush}" />
                                    <TextBlock Text="How it was done" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ActivitySummary}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding SelectedActivity}" ItemTemplate="{StaticResource ActivityLineTemplate}" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
