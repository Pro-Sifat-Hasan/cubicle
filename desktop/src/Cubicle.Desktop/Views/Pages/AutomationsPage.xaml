<UserControl x:Class="Cubicle.Desktop.Views.Pages.AutomationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cubicle.Desktop.ViewModels"
             xmlns:controls="clr-namespace:Cubicle.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="900" HorizontalAlignment="Left" DataContext="{Binding Automations}">
            <TextBlock Text="Automations" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Work your staff do on a schedule, even while this window is closed. Send it to the main agent to have it planned with the team, or straight to one agent." />

            <!-- Composer / editor -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Cancel editing" Command="{Binding CancelEditCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             controls:Placeholder.Text="e.g. Morning briefing: plan my day" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                             controls:Placeholder.Text="What should be done each time, and what does a great result look like?" />

                    <TextBlock Text="WHO DOES IT" Style="{StaticResource Label}" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding AgentChoices}" SelectedItem="{Binding Agent}" DisplayMemberPath="Label" MaxWidth="460" HorizontalAlignment="Left" MinWidth="320" />

                    <WrapPanel Margin="0,14,0,0">
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="REPEAT" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding RepeatKinds}" SelectedIndex="{Binding RepeatKind}" Width="180" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8" Visibility="{Binding ShowDate, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="DATE" Style="{StaticResource Label}" />
                            <DatePicker SelectedDate="{Binding OnceDate}" Width="150" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8" Visibility="{Binding ShowTime, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="TIME (24H)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" Width="96" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8" Visibility="{Binding ShowInterval, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="EVERY (MINUTES)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding EveryMinutes, UpdateSourceTrigger=PropertyChanged}" Width="96" />
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Visibility="{Binding ShowDays, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                        <TextBlock Text="ON" Style="{StaticResource Label}" />
                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,6,6">
                                        <CheckBox IsChecked="{Binding IsChecked}">
                                            <TextBlock Text="{Binding Label}" />
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource TextOnAccentBrush}" />
                            <TextBlock Text="{Binding SaveLabel}" Foreground="{DynamicResource TextOnAccentBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource EmptyState}" Visibility="{Binding Routines.Count, Converter={StaticResource ZeroToVisibility}}">
                <TextBlock Style="{StaticResource Muted}" Text="No automations yet. Try 'Every weekday at 08:30: summarise what's on my plate today'." />
            </Border>

            <ItemsControl ItemsSource="{Binding Routines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18,14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,12,0" ToolTip="Turn this automation on or off">
                                        <TextBlock Text="On" />
                                    </CheckBox>
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding RunNowCommand}" Margin="0,0,6,0" ToolTip="Run it now (the schedule stays the same)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Run now" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding EditCommand}" ToolTip="Edit" Padding="10,8" Margin="0,0,6,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding DeleteCommand}" ToolTip="Delete automation" Padding="10,8">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8EE;" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Routine.Title}" FontWeight="SemiBold" FontSize="15" />
                                        <Border Style="{StaticResource StatusPill}" Tag="{Binding LastStatus}" Margin="10,0,0,0"
                                                Visibility="{Binding LastStatusLabel, Converter={StaticResource NullToVisibility}}">
                                            <TextBlock Text="{Binding LastStatusLabel}" Style="{StaticResource PillText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                                        <Run Text="{Binding When, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Who, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                        <Run Text="{Binding NextRun, Mode=OneWay}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding LastRun, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
