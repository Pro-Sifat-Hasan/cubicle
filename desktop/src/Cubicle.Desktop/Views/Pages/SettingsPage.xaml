<UserControl x:Class="Cubicle.Desktop.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cubicle.Desktop.ViewModels"
             xmlns:controls="clr-namespace:Cubicle.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Everything stays on this PC. Keys are encrypted with Windows DPAPI and never shown again." />

            <!-- ================= AI provider ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" DataContext="{Binding Ai}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="AI provider" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Text="Choose the AI your staff work with. Saving restarts them with the new setup." />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="PROVIDER" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="  ✓ connected" Foreground="{DynamicResource SuccessBrush}"
                                               Visibility="{Binding Configured, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding SelectedProvider.Description}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,8,0,16" />

                    <StackPanel Visibility="{Binding SelectedProvider.NeedsKey, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="API KEY" />
                            <Run Text="{Binding SelectedProvider.SecretName, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </TextBlock>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Save key" Margin="10,0,0,0" Click="SaveApiKey_Click" />
                            <PasswordBox x:Name="ApiKeyBox" />
                        </DockPanel>
                        <TextBlock Text="Stored encrypted on this PC and never shown again." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedProvider.BaseUrlEditable, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
                        <TextBlock Text="SERVER URL" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="http://127.0.0.1:11434/v1" />
                    </StackPanel>

                    <TextBlock Text="MODEL" Style="{StaticResource Label}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding TestConnectionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,7,0" />
                                <TextBlock Text="Test connection" />
                            </StackPanel>
                        </Button>
                        <ComboBox IsEditable="True" ItemsSource="{Binding Models}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                               Visibility="{Binding ConnectionStatus, Converter={StaticResource NullToVisibility}}" />

                    <Grid Margin="0,16,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="EFFORT" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding Efforts}" SelectedItem="{Binding Effort}"
                                      ToolTip="Higher effort means more careful work but more tokens (Claude models)." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DAILY TOKEN BUDGET" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding DailyBudget, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="Default (0 = unlimited)" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="YOUR NAME" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" controls:Placeholder.Text="How your staff address you" Margin="0,0,0,14" />

                    <CheckBox IsChecked="{Binding WebAccess}" Margin="0,0,0,18">
                        <TextBlock Text="Allow web search and browsing" />
                    </CheckBox>

                    <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Command="{Binding SaveCommand}">
                        <TextBlock Text="Save AI settings" Foreground="{DynamicResource TextOnAccentBrush}" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ================= Your staff ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Your staff" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Rename your chief of staff, switch profession or pick another passion. Teammates who are already hired stay." />
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding RunSetupAgainCommand}" Content="Run setup again" />
                </StackPanel>
            </Border>

            <!-- ================= Appearance ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButton}" MinWidth="100"
                                         IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}">
                                <StackPanel Orientation="Horizontal" Margin="6,2">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Light" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentButton}" MinWidth="100"
                                         IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}">
                                <StackPanel Orientation="Horizontal" Margin="6,2">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Dark" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentButton}" MinWidth="100"
                                         IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}">
                                <StackPanel Orientation="Horizontal" Margin="6,2">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="System" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ================= Background ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Background" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <CheckBox IsChecked="{Binding StartWithWindows}">
                        <TextBlock Text="Start Cubicle when I sign in to Windows (runs quietly in the tray)" TextWrapping="Wrap" TextTrimming="None" />
                    </CheckBox>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" FontSize="12.5"
                               Text="Closing this window keeps your staff working. To stop everything, right-click the tray icon and choose 'Stop staff and quit'." />
                </StackPanel>
            </Border>

            <!-- ================= Data & about ================= -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Data and about" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" Margin="0,0,7,0" />
                                <TextBlock Text="Open data folder" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ResetBreakerCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" Margin="0,0,7,0" />
                                <TextBlock Text="Resume paused work" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenRepoCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="13" Margin="0,0,7,0" />
                                <TextBlock Text="GitHub" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding VersionText}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
