root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.go]
indent_style = tab

[*.{yml,yaml,json,xml,csproj,props,slnx,xaml,manifest}]
indent_size = 2

[*.xaml]
indent_size = 4

[*.{ps1,iss}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
